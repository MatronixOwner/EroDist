#!/bin/bash
set -euo pipefail
[[ -d /run/archiso ]] || exit 1
if ! id tester >/dev/null 2>&1; then
    useradd -m -G wheel,audio,video -s /bin/bash tester
    echo 'tester:live' | chpasswd
fi
passwd -l root
install -d /etc/lightdm/lightdm.conf.d
printf '[Seat:*]\nautologin-user=tester\nautologin-user-timeout=0\n' > /etc/lightdm/lightdm.conf.d/90-erodist-live.conf
# Arch LightDM requires membership of the autologin group.
getent group autologin >/dev/null || groupadd -r autologin
usermod -aG autologin tester
