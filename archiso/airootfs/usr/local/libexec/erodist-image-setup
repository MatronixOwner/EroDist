#!/bin/bash
set -euo pipefail
locale-gen
# Copy Arc decorations/resources from the distribution package at image build time.
if [[ ! -d /usr/share/themes/EroDist-Black/xfwm4 ]]; then
  cp -aL /usr/share/themes/Arc-Dark/xfwm4 /usr/share/themes/EroDist-Black/
fi
if [[ -f /usr/share/themes/Arc-Dark/gtk-3.0/gtk.gresource ]]; then
  cp -L /usr/share/themes/Arc-Dark/gtk-3.0/gtk.gresource /usr/share/themes/EroDist-Black/gtk-3.0/
fi
