#!/usr/bin/python3 -I
"""Root entry: only reviewed catalog bundles, full upgrade before installation."""
import json
import os
from pathlib import Path
import re
import sys


def packages_for(key):
    catalog = json.loads(Path('/usr/share/erodist/apps.json').read_text())
    if key not in catalog:
        raise ValueError('Unknown application')
    packages = catalog[key]['packages']
    if not packages or not all(re.fullmatch(r'[a-z0-9][a-z0-9+._-]*', p) for p in packages):
        raise ValueError('Invalid package configuration')
    return packages


if __name__ == '__main__':
    if len(sys.argv) != 2:
        sys.exit('Expected one catalog application ID')
    packages = packages_for(sys.argv[1])
    if os.geteuid() != 0:
        sys.exit('Administrator authentication required')
    os.execve('/usr/bin/pacman', ['pacman', '-Syu', '--needed', '--', *packages],
              {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': '/root', 'TERM': os.environ.get('TERM', 'xterm'), 'LANG': 'ru_RU.UTF-8'})
