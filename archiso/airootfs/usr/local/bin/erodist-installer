#!/usr/bin/python3
"""Non-privileged entry point. Disk operations belong exclusively to Archinstall."""
from pathlib import Path
import subprocess
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk


def is_live(cmdline):
    return any(p.startswith('archisobasedir=') for p in cmdline.split())


def main():
    if not is_live(Path('/proc/cmdline').read_text()):
        dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.CLOSE, text='EroDist уже установлен')
        dialog.format_secondary_text('Установщик запускается только из Live-системы. Для переустановки загрузитесь с ISO. Сделайте резервную копию данных.')
        dialog.run()
        dialog.destroy()
        return 1
    dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING,
        buttons=Gtk.ButtonsType.OK_CANCEL, text='Открыть установщик EroDist?')
    dialog.format_secondary_text('Сначала тестируйте на пустом виртуальном диске. Выбор разметки может удалить данные. Откроется текстовый мастер Archinstall. Оставьте профиль EroDist XFCE, выберите диск и создайте своего пользователя. Проверьте сводку и окончательное подтверждение перед установкой. Не запускайте второй установщик одновременно.')
    result = dialog.run()
    dialog.destroy()
    if result != Gtk.ResponseType.OK:
        return 0
    subprocess.Popen(['xfce4-terminal', '--disable-server', '--hold', '--execute', 'sudo', '/usr/local/libexec/erodist-system-installer'])
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
