#!/usr/bin/python3
"""Arch Linux catalog; all package operations use argv, never shell input."""
import json
import os
from pathlib import Path
import re
import subprocess
import threading
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib

CATALOG = json.loads(Path('/usr/share/erodist/apps.json').read_text())


def plan(packages):
    env = dict(os.environ, LC_ALL='C')
    # Read-only preview. The final transaction is always pacman -Syu, never -Sy install.
    result = subprocess.run(['pacman', '-Sp', '--print-format', '%n %v %s', '--', *packages],
                            env=env, capture_output=True, text=True, timeout=90)
    if result.returncode:
        raise RuntimeError(result.stderr or result.stdout)
    total = sum(int(line.split()[-1]) for line in result.stdout.splitlines()
                if line.split() and line.split()[-1].isdigit())
    return ('Источник: официальные репозитории Arch Linux, включая multilib.\n'
            f'Пакеты приложения по текущей базе: около {total / 1048576:.1f} МиБ.\n'
            'Это оценка без полного обновления системы. Итоговый размер, конфликты и удаления '
            'проверьте в терминале: установка выполняет pacman -Syu. Нужны интернет и свободное место.\n\n' + result.stdout)


class Catalog(Gtk.Window):
    def __init__(self):
        super().__init__(title='Популярные программы — EroDist')
        self.set_default_size(760, 640)
        self.set_border_width(20)
        self.connect('destroy', Gtk.main_quit)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(box)
        self.select = Gtk.ComboBoxText()
        for key, entry in CATALOG.items():
            self.select.append(key, entry['name'])
        self.select.set_active(0)
        self.select.connect('changed', self.changed)
        box.pack_start(self.select, False, False, 0)
        self.description = Gtk.Label()
        self.description.set_line_wrap(True)
        box.pack_start(self.description, False, False, 0)
        self.preview = Gtk.Button(label='Показать пакеты и размер')
        self.preview.connect('clicked', self.preview_plan)
        box.pack_start(self.preview, False, False, 0)
        self.view = Gtk.TextView(editable=False, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        scroll = Gtk.ScrolledWindow()
        scroll.add(self.view)
        box.pack_start(scroll, True, True, 0)
        self.install = Gtk.Button(label='Установить выбранную программу…')
        self.install.connect('clicked', self.confirm)
        box.pack_start(self.install, False, False, 0)
        box.pack_start(Gtk.Label(label='В Live-сессии программы исчезнут после перезагрузки.'), False, False, 0)
        self.changed()

    def changed(self, *_):
        self.approved_key = None
        self.install.set_sensitive(False)
        self.description.set_text(CATALOG[self.select.get_active_id()]['description'])
        self.view.get_buffer().set_text('Сначала просмотрите план. Для свежего индекса используйте «Обновления» в центре настроек.')

    def preview_plan(self, *_):
        key = self.select.get_active_id()
        self.preview.set_sensitive(False)
        self.select.set_sensitive(False)
        self.install.set_sensitive(False)
        self.view.get_buffer().set_text('Расчёт зависимостей…')
        def work():
            try:
                text, success = plan(CATALOG[key]['packages']), True
            except (OSError, ValueError, AttributeError, subprocess.SubprocessError, RuntimeError) as exc:
                text, success = 'Не удалось рассчитать план: ' + str(exc), False
            GLib.idle_add(self.ready, key, text, success)
        threading.Thread(target=work, daemon=True).start()

    def ready(self, key, text, success):
        self.view.get_buffer().set_text(text)
        self.preview.set_sensitive(True)
        self.select.set_sensitive(True)
        self.approved_key = key if success else None
        self.install.set_sensitive(success)
        return False

    def confirm(self, *_):
        if self.approved_key != self.select.get_active_id():
            return
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.OK_CANCEL,
                                   text='Открыть установку в терминале?')
        dialog.format_secondary_text('Потребуется пароль администратора. Проверьте итоговый план pacman и подтвердите установку в терминале. Не закрывайте окно во время установки.')
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            try:
                # ID comes exclusively from the static catalog, not from user-entered commands.
                subprocess.Popen(['xfce4-terminal', '--disable-server', '--hold', '--execute',
                                  'sudo', '/usr/local/libexec/erodist-install', self.approved_key])
                self.changed()
            except OSError as exc:
                self.view.get_buffer().set_text(str(exc))


if __name__ == '__main__':
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument('--app', choices=list(CATALOG))
    args = parser.parse_args()
    window = Catalog()
    if args.app:
        window.select.set_active_id(args.app)
    window.show_all()
    Gtk.main()
