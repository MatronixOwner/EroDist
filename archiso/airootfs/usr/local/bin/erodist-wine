#!/usr/bin/python3
"""Explicitly confirmed user-level Wine launcher, not a security sandbox."""
from pathlib import Path
import os
import shutil
import struct
import subprocess
import sys


def validate_exe(filename):
    path = Path(filename).expanduser().resolve(strict=True)
    if not path.is_file() or path.suffix.lower() != '.exe':
        raise ValueError('Выберите обычный файл с расширением .exe.')
    with path.open('rb') as stream:
        header = stream.read(64)
        if len(header) != 64 or header[:2] != b'MZ':
            raise ValueError('Это не Windows EXE (отсутствует заголовок MZ).')
        offset = struct.unpack_from('<I', header, 60)[0]
        if not 64 <= offset <= min(path.stat().st_size - 6, 16 * 1024 * 1024):
            raise ValueError('Некорректный заголовок EXE.')
        stream.seek(offset)
        pe = stream.read(6)
        if pe[:4] != b'PE\0\0':
            raise ValueError('Поддерживаются Windows PE EXE, а не DOS-программы.')
        machine = struct.unpack_from('<H', pe, 4)[0]
        if machine not in (0x14c, 0x8664):
            raise ValueError('Поддерживаются EXE для x86 и x86-64, не ARM.')
    return path


def command_for(path):
    return ['/usr/bin/wine', str(path)]


def main():
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk

    def message(title, detail, warning=False):
        dialog = Gtk.MessageDialog(buttons=Gtk.ButtonsType.OK_CANCEL if warning else Gtk.ButtonsType.CLOSE,
            message_type=Gtk.MessageType.WARNING if warning else Gtk.MessageType.INFO, text=title)
        dialog.format_secondary_text(detail)
        result = dialog.run()
        dialog.destroy()
        return result == Gtk.ResponseType.OK

    if os.geteuid() == 0:
        message('Не запускайте Wine от root', 'Откройте EXE из обычной пользовательской сессии без sudo.')
        return 1
    if len(sys.argv) > 2:
        message('Выберите один EXE', 'Аргументы командной строки для Windows-программы здесь не поддерживаются.')
        return 1
    if len(sys.argv) == 2:
        filename = sys.argv[1]
    else:
        chooser = Gtk.FileChooserDialog(title='Выберите Windows-программу (.exe)', action=Gtk.FileChooserAction.OPEN)
        chooser.add_buttons('Отмена', Gtk.ResponseType.CANCEL, 'Открыть', Gtk.ResponseType.OK)
        filt = Gtk.FileFilter()
        filt.set_name('Windows EXE')
        filt.add_pattern('*.[eE][xX][eE]')
        chooser.add_filter(filt)
        result = chooser.run()
        filename = chooser.get_filename() if result == Gtk.ResponseType.OK else None
        chooser.destroy()
        if not filename:
            return 0
    try:
        path = validate_exe(filename)
    except (OSError, ValueError) as exc:
        message('Не удалось открыть EXE', str(exc))
        return 1
    if not shutil.which('wine'):
        if message('Сначала установите Wine', 'В каталоге откроется пункт Wine (32/64 бит). Просмотрите объём загрузки и подтвердите установку. Нужны интернет и свободное место. После установки откройте EXE повторно.', True):
            subprocess.Popen(['erodist-apps', '--app', 'wine'])
        return 0
    if not message('Запустить Windows-программу?', f'{path}\n\nЗапускайте только доверенные файлы. Wine НЕ является песочницей: программа может читать и изменять ваши файлы и обращаться к сети. Совместимость не гарантируется, особенно для драйверов и античитов. Первый запуск может занять несколько минут.', True):
        return 0
    prefix = Path.home() / '.local/share/erodist/wine/default'
    logs = Path.home() / '.local/state/erodist/wine'
    try:
        prefix.mkdir(parents=True, exist_ok=True, mode=0o700)
        logs.mkdir(parents=True, exist_ok=True, mode=0o700)
        import tempfile
        fd, logfile = tempfile.mkstemp(prefix='launch-', suffix='.log', dir=logs)
        env = dict(os.environ, WINEPREFIX=str(prefix), WINEARCH='win64')
        # Capture diagnostics locally; never interpolate the filename into shell code.
        with os.fdopen(fd, 'w') as log:
            log.write(f'EXE: {path}\nWine prefix: {prefix}\n')
            log.flush()
            process = subprocess.Popen(command_for(path), cwd=path.parent, env=env,
                                       stdout=log, stderr=subprocess.STDOUT)
            import threading
            from gi.repository import GLib
            def done():
                code = process.wait()
                if code:
                    GLib.idle_add(show_failure, code)
                else:
                    GLib.idle_add(Gtk.main_quit)
            def show_failure(code):
                message('Программа завершилась с ошибкой', f'Код: {code}\nЖурнал: {logfile}\nНе все EXE совместимы с Wine. Перед отправкой журнала проверьте личные данные.')
                Gtk.main_quit()
                return False
            threading.Thread(target=done, daemon=True).start()
        Gtk.main()
    except OSError as exc:
        message('Ошибка запуска Wine', str(exc))
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
