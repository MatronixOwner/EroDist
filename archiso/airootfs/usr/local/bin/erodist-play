#!/usr/bin/python3
"""Games and recording hub. Tools are opt-in; no downloads or recording on start."""
from pathlib import Path
import os
import shutil
import subprocess

TOOLS = {
    'steam': {'name': 'Steam', 'binary': 'steam', 'fallback': '/usr/games/steam', 'app': 'steam'},
    'gamepad': {'name': 'Проверка геймпада', 'binary': 'evtest', 'app': 'gamepad'},
    'obs': {'name': 'OBS Studio', 'binary': 'obs', 'app': 'obs'},
}


def tool_command(key):
    tool = TOOLS[key]
    binary = shutil.which(tool['binary'])
    if not binary and tool.get('fallback') and os.access(tool['fallback'], os.X_OK):
        binary = tool['fallback']
    return [binary] if binary else None


def catalog_command(key):
    return ['erodist-apps', '--app', TOOLS[key]['app']]


def main():
    import argparse
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk
    parser = argparse.ArgumentParser()
    parser.add_argument('--tab', choices=['games', 'recording'], default='games')
    args = parser.parse_args()

    class Hub(Gtk.Window):
        def __init__(self):
            super().__init__(title='Игры и запись экрана — EroDist')
            self.set_default_size(720, 590)
            self.set_border_width(22)
            self.connect('destroy', Gtk.main_quit)
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            self.add(outer)
            tabs = Gtk.Notebook()
            outer.pack_start(tabs, True, True, 0)
            games = self.page(tabs, 'Игры')
            self.label(games, 'Steam и совместимые Windows-игры через Proton.\nНужны интернет, аккаунт Steam и место на диске. Не все игры и античиты совместимы.')
            self.button(games, 'Установить Steam и библиотеки Mesa/Vulkan…', lambda: self.run(catalog_command('steam')))
            self.button(games, 'Запустить Steam', lambda: self.start_tool('steam'))
            self.button(games, 'Проверить геймпад', lambda: self.start_tool('gamepad'))
            self.button(games, 'Настройка Proton, драйверов и геймпада', lambda: self.guide('gaming.html'))
            self.label(games, 'Mesa предназначена для открытых драйверов. Проприетарный NVIDIA-драйвер и его 32-битные библиотеки требуют отдельной настройки. Proton скачивается самим Steam после выбора пользователем.')
            recording = self.page(tabs, 'Запись экрана')
            self.label(recording, 'OBS Studio: запись экрана, окна, звука и микрофона.\nЗапись не начинается автоматически — сначала выберите источники и папку сохранения.')
            self.button(recording, 'Установить OBS Studio…', lambda: self.run(catalog_command('obs')))
            self.button(recording, 'Открыть OBS Studio', lambda: self.start_tool('obs'))
            self.button(recording, 'Настроить громкость и источники звука', lambda: self.run(['pavucontrol']))
            self.button(recording, 'Инструкция: первая запись со звуком', lambda: self.guide('recording.html'))
            self.label(recording, 'Записывайте только с согласия участников. Перед записью уберите личные окна, уведомления и пароли. В Live-сессии видео на системном диске исчезнет после перезагрузки.')
            tabs.set_current_page(1 if args.tab == 'recording' else 0)
            self.status = Gtk.Label(label='Steam, Proton, OBS и игры не загружаются без вашего действия.')
            self.status.set_line_wrap(True)
            outer.pack_start(self.status, False, False, 0)

        def page(self, tabs, title):
            scroll = Gtk.ScrolledWindow()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            box.set_border_width(18)
            scroll.add(box)
            tabs.append_page(scroll, Gtk.Label(label=title))
            return box

        def label(self, box, text):
            label = Gtk.Label(label=text, xalign=0)
            label.set_line_wrap(True)
            label.set_max_width_chars(65)
            box.pack_start(label, False, False, 4)

        def button(self, box, title, callback):
            button = Gtk.Button(label=title)
            button.connect('clicked', lambda _: callback())
            box.pack_start(button, False, False, 0)

        def run(self, command):
            try:
                subprocess.Popen(command)
            except OSError as exc:
                self.status.set_text('Ошибка запуска: ' + str(exc))

        def guide(self, filename):
            self.run(['xdg-open', (Path('/usr/share/erodist') / filename).as_uri()])

        def start_tool(self, key):
            if os.geteuid() == 0:
                self.status.set_text('Откройте программу от обычного пользователя, без sudo/root.')
                return
            command = tool_command(key)
            if command:
                if key == 'gamepad':
                    command = ['xfce4-terminal', '--disable-server', '--hold', '--execute', 'sudo', *command]
                self.run(command)
                self.status.set_text('Запущено: ' + TOOLS[key]['name'] + '. Запись экрана нужно начать вручную в OBS.')
                return
            dialog = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.OK_CANCEL,
                                       text=TOOLS[key]['name'] + ' ещё не установлен')
            dialog.format_secondary_text('Открыть нужный пункт каталога? Просмотрите размер и зависимости, подтвердите установку и затем повторно нажмите запуск. Потребуются интернет и права администратора.')
            response = dialog.run()
            dialog.destroy()
            if response == Gtk.ResponseType.OK:
                self.run(catalog_command(key))

    Hub().show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
