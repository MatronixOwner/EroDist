#!/bin/sh
# Root-only, fixed command and config, no arguments, no user-supplied environment.
set -eu
[ "$#" -eq 0 ] || exit 2
[ "$(id -u)" -eq 0 ] || exit 1
case " $(cat /proc/cmdline) " in
    *" boot=live "*) ;;
    *) echo 'Installer is available only in a Live session.' >&2; exit 1 ;;
esac
[ -r /run/live/medium/live/filesystem.squashfs ] || {
    echo 'Live filesystem image not found.' >&2; exit 1;
}
# Prevent two launches from moving /etc/fstab or partitioning concurrently.
exec 9>/run/lock/erodist-installer.lock
flock -n 9 || { echo 'Installer already running.' >&2; exit 1; }
# Debian's Calamares wrapper moves the Live fstab out of the way before partitioning.
backup=/etc/fstab.erodist-live
[ ! -e "$backup" ] || { echo 'Stale fstab backup exists; reboot Live before retrying.' >&2; exit 1; }
restore_fstab() {
    if [ -f "$backup" ]; then mv -- "$backup" /etc/fstab; fi
}
trap restore_fstab EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [ -f /etc/fstab ]; then mv -- /etc/fstab "$backup"; fi
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_STYLE_OVERRIDE=Fusion
unset QT_QPA_PLATFORM_PLUGIN_PATH QT_PLUGIN_PATH QML2_IMPORT_PATH PYTHONPATH PYTHONHOME || true
/usr/bin/calamares --config /etc/calamares
