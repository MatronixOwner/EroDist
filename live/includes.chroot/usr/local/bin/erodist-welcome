#!/usr/bin/python3
"""Local GTK welcome centre. No telemetry, automatic uploads or shell commands."""
from pathlib import Path
import subprocess
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib

ISSUES = 'https://github.com/d50130483-ship-it/EroDist/issues/new/choose'
GUIDE = '/usr/share/erodist/guide.html'
MARKER = Path.home() / '.config/erodist/hide-welcome'


class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(title='Добро пожаловать в EroDist')
        self.set_default_size(620, 560)
        self.set_border_width(28)
        self.connect('destroy', Gtk.main_quit)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(box)
        title = Gtk.Label()
        title.set_markup('<span size="26000" weight="bold">EroDist 0.4</span>')
        box.pack_start(title, False, False, 8)
        subtitle = Gtk.Label(label='Твоя система. Твоё пространство.\nDebian 12 · XFCE · RU / EN: Alt + Shift')
        box.pack_start(subtitle, False, False, 4)
        for text, callback in [
            ('Центр настроек EroDist', lambda *_: self.launch(['erodist-settings'])),
            ('Популярные программы и Python', lambda *_: self.launch(['erodist-apps'])),
            ('Установить систему…', self.install),
            ('Инструкция и проверка установки', lambda *_: self.open_uri(Path(GUIDE).as_uri())),
            ('Проверить обновления', lambda *_: self.launch(['gpk-update-viewer'])),
            ('Создать и просмотреть отчёт о баге', self.report),
            ('Сообщить об ошибке на GitHub', lambda *_: self.open_uri(ISSUES)),
        ]:
            button = Gtk.Button(label=text)
            button.connect('clicked', callback)
            box.pack_start(button, False, False, 0)
        self.status = Gtk.Label(label='Отчёты никуда не отправляются автоматически.')
        self.status.set_line_wrap(True)
        box.pack_start(self.status, False, False, 8)
        hide = Gtk.CheckButton(label='Не показывать при входе')
        hide.set_active(MARKER.exists())
        hide.connect('toggled', self.toggle_autostart)
        box.pack_end(hide, False, False, 0)

    def launch(self, args):
        try:
            subprocess.Popen(args)
        except OSError as exc:
            self.status.set_text('Не удалось запустить: ' + str(exc))

    def open_uri(self, uri):
        self.launch(['xdg-open', uri])

    def toggle_autostart(self, button):
        if button.get_active():
            MARKER.parent.mkdir(parents=True, exist_ok=True)
            MARKER.touch()
        else:
            MARKER.unlink(missing_ok=True)

    def install(self, *_):
        self.launch(['erodist-installer'])

    def report(self, *_):
        self.status.set_text('Создание отчёта…')
        # Async: gathering diagnostics must not freeze the desktop window.
        from gi.repository import Gio
        try:
            process = Gio.Subprocess.new(['erodist-report', '--path-only'], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
            process.communicate_utf8_async(None, None, self.report_done, None)
        except GLib.Error as exc:
            self.status.set_text(str(exc))

    def report_done(self, process, result, _):
        try:
            _, output, error = process.communicate_utf8_finish(result)
            if not process.get_successful():
                self.status.set_text('Ошибка отчёта: ' + error)
                return
            path = Path(output.strip())
            self.status.set_text('Отчёт: ' + str(path) + '\nПроверьте и удалите личные данные перед отправкой.')
            self.launch(['mousepad', str(path)])
        except GLib.Error as exc:
            self.status.set_text(str(exc))


if __name__ == '__main__':
    import sys
    if '--autostart' not in sys.argv or not MARKER.exists():
        Welcome().show_all()
        Gtk.main()
