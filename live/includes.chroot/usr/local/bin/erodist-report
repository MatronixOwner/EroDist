#!/bin/sh
set -eu
umask 077
file="$(mktemp "${HOME}/erodist-report.XXXXXX.txt")"
{
  echo 'EroDist 0.4.0 diagnostic report'
  date -u
  uname -srmo
  cat /etc/os-release
  printf '\n=== Boot mode ===\n'
  if [ -d /sys/firmware/efi ]; then echo UEFI; else echo BIOS; fi
  printf '\n=== Session ===\n'
  printf 'Desktop: %s; session: %s\n' "${XDG_CURRENT_DESKTOP:-unknown}" "${XDG_SESSION_TYPE:-unknown}"
  printf '\n=== PCI devices and drivers ===\n'
  if command -v lspci >/dev/null; then lspci -nnk; fi
  printf '\n=== Memory ===\n'
  free -h
  printf '\n=== Failed services ===\n'
  systemctl --failed --no-pager || true
  printf '\n=== EroDist packages ===\n'
  dpkg-query -W xfce4 lightdm linux-image-amd64 firefox-esr gnome-packagekit 2>/dev/null || true
} > "$file" 2>&1
if [ "${1:-}" = '--path-only' ]; then
  printf '%s\n' "$file"
else
  printf 'Отчёт: %s\nПроверьте личные данные перед отправкой.\n' "$file"
fi
