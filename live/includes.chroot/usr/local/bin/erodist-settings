#!/usr/bin/python3
import subprocess
from pathlib import Path
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk


class Settings(Gtk.Window):
    def __init__(self):
        super().__init__(title='Центр настроек EroDist')
        self.set_default_size(620, 650)
        self.set_border_width(20)
        self.connect('destroy', Gtk.main_quit)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll = Gtk.ScrolledWindow()
        scroll.add(box)
        self.add(scroll)
        box.pack_start(Gtk.Label(label='EroDist 0.6 · Настройки и обслуживание'), False, False, 10)
        actions = [
            ('Игры — Steam, Proton и геймпад', ['erodist-play', '--tab', 'games']),
            ('Запись экрана — OBS Studio', ['erodist-play', '--tab', 'recording']),
            ('О системе EroDist', ['erodist-about']),
            ('Windows-программы (Wine)', ['erodist-wine']),
            ('Оформление и значки', ['xfce4-appearance-settings']),
            ('Обои и рабочий стол', ['xfdesktop-settings']),
            ('Панель', ['xfce4-panel', '--preferences']),
            ('Клавиатура и горячие клавиши', ['xfce4-keyboard-settings']),
            ('Мониторы и разрешение', ['xfce4-display-settings']),
            ('Звук', ['pavucontrol']),
            ('Сеть', ['nm-connection-editor']),
            ('Питание, яркость, сон и батарея', ['xfce4-power-manager-settings']),
            ('Популярные программы и Python', ['erodist-apps']),
            ('Обновления', ['gpk-update-viewer']),
            ('Резервные снимки системы (Timeshift)…', None),
            ('Скриншот с пометками', ['flameshot', 'gui']),
            ('Инструкция и горячие клавиши', ['xdg-open', 'file:///usr/share/erodist/guide.html']),
        ]
        for title, command in actions:
            button = Gtk.Button(label=title)
            button.connect('clicked', lambda _, cmd=command: self.launch(cmd))
            box.pack_start(button, False, False, 0)
        self.status = Gtk.Label()
        self.status.set_line_wrap(True)
        box.pack_start(self.status, False, False, 0)

    def launch(self, command):
        if command is None:
            if 'boot=live' in Path('/proc/cmdline').read_text().split():
                self.status.set_text('Timeshift настраивается после установки на диск, не в Live-сессии.')
                return
            dialog = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.OK_CANCEL,
                                       text='Настроить снимки системы?')
            dialog.format_secondary_text('Timeshift требует свободного места и прав администратора. Выберите диск и расписание в мастере. Личные файлы копируйте отдельно. Не запускайте восстановление без резервной копии важных данных.')
            response = dialog.run()
            dialog.destroy()
            if response != Gtk.ResponseType.OK:
                return
            command = ['pkexec', 'timeshift-gtk']
        try:
            subprocess.Popen(command)
        except OSError as exc:
            self.status.set_text(str(exc))


if __name__ == '__main__':
    Settings().show_all()
    Gtk.main()
