#!/bin/sh
set -eu
# Keep the Debian-maintained job sequence, storage stack and bootloader scripts.
# Only branding, confirmation policy, and conservative UI defaults change here.
python3 - <<'PY'
from pathlib import Path
import yaml
import re

settings_path = Path('/etc/calamares/settings.conf')
settings = yaml.safe_load(settings_path.read_text())
assert settings['sequence'], 'Debian Calamares settings missing'
shown = [item for phase in settings['sequence'] for item in phase.get('show', [])]
assert all(item in shown for item in ['partition', 'users', 'summary', 'finished'])
settings.update({'branding': 'erodist', 'prompt-install': True,
                 'disable-cancel-during-exec': True, 'dont-chroot': False})
settings_path.write_text(yaml.safe_dump(settings, sort_keys=False))

# Make selection explicit: never preselect disk erasure.
partition_path = Path('/etc/calamares/modules/partition.conf')
partition = yaml.safe_load(partition_path.read_text()) if partition_path.exists() else {}
partition = partition or {}
partition['initialPartitioningChoice'] = 'none'
partition_path.write_text(yaml.safe_dump(partition, sort_keys=False))

welcome_path = Path('/etc/calamares/modules/welcome.conf')
welcome = yaml.safe_load(welcome_path.read_text())
welcome['showDonateUrl'] = False
welcome['requirements']['requiredStorage'] = 25
welcome['requirements']['requiredRam'] = 2
welcome_path.write_text(yaml.safe_dump(welcome, sort_keys=False))

# EFI directory and menu entry must consistently identify the installed EroDist.
boot_path = Path('/etc/calamares/modules/bootloader.conf')
boot = yaml.safe_load(boot_path.read_text())
boot.update({'efiBootloaderId': 'EroDist', 'bootloaderEntryName': 'EroDist'})
boot_path.write_text(yaml.safe_dump(boot, sort_keys=False))

# Keep the same archive areas after installation: Steam is in contrib.
# Debian's sources-final helper generates target sources.list late in the install.
source_script = Path('/usr/sbin/sources-final')
assert source_script.is_file(), 'Debian sources-final helper missing'
source_text = source_script.read_text()
pattern = r'(?m)^(deb(?:-src)?\s+\S+\s+\S+\s+)(main[^\n]*)$'
source_text, count = re.subn(pattern, lambda m: m.group(1) + 'main contrib non-free non-free-firmware', source_text)
assert count >= 2, 'No Debian archive lines found in sources-final helper'
source_script.write_text(source_text)

branding_path = Path('/etc/calamares/branding/erodist')
branding = yaml.safe_load((branding_path / 'branding.desc').read_text())
for asset in [*branding['images'].values(), branding['slideshow'], 'stylesheet.qss']:
    assert (branding_path / asset).is_file(), asset
assert Path('/run/live/medium').is_absolute()
PY
# Hide the upstream shortcut: the EroDist launcher preserves the Debian fstab workaround
# while adding Live-mode checking, authorization and single-instance locking.
for launcher in /usr/share/applications/calamares.desktop /usr/share/applications/calamares-install-debian.desktop; do
    if [ -f "$launcher" ]; then
        sed -i '/^NoDisplay=/d; /^\[Desktop Entry\]/a NoDisplay=true' "$launcher"
    fi
done
command -v calamares
command -v flock
python3 -m py_compile /usr/local/bin/erodist-installer
